{{#> layouts/base }} {{#*inline "content-block"}}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Fabrik-Übersicht</h4>
        <span class="badge bg-primary">{{factoryCount}} eigene Fabriken</span>
    </div>

    <div class="card mb-3">
        <div class="card-header"><i class="fas fa-eye me-2"></i>Überwachungsstatus</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-4">
                <div>
                    <small class="text-muted d-block">Letzte Prüfung</small>
                    {{#if lastFactoryCheck}}
                    <span>{{formatTime lastFactoryCheck}}</span>
                    {{else}}
                    <span class="text-muted">Noch keine Prüfung gespeichert</span>
                    {{/if}}
                </div>
                <div>
                    <small class="text-muted d-block">API-Token</small>
                    {{#if invalidToken}}
                    <span class="badge bg-danger">Ungültig – bitte erneut anmelden</span>
                    {{else}}
                    <span class="badge bg-success">Status in Ordnung</span>
                    {{/if}}
                </div>
            </div>
            {{#unless trackingDataAvailable}}
            <div class="alert alert-warning mt-3 mb-0">Die gespeicherten Fabrik-Überwachungsdaten konnten nicht gelesen werden.</div>
            {{/unless}}
        </div>
    </div>

    <div class="card">
        <div class="card-header"><i class="fas fa-industry me-2"></i>Eigene Fabriken</div>
        <div class="card-body p-0">
            {{#if factoriesAvailable}}
                {{#if factories.length}}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Fabrik</th>
                                <th>Standort</th>
                                <th>Produkt</th>
                                <th>Nächste Einnahme</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each factories}}
                            <tr>
                                <td class="text-muted">{{this.ID}}</td>
                                <td>{{this.type}}</td>
                                <td>{{this.name}}</td>
                                <td><span class="badge bg-secondary">{{this.item}}</span></td>
                                <td>
                                    {{#if this.NextCapture}}
                                    <span title="{{formatTime (multi this.NextCapture 1000)}}">{{momentFromNow (multi this.NextCapture 1000)}}</span>
                                    {{else}}
                                    <span class="text-muted">Keine Angabe</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="p-3 text-muted">Derzeit sind keine eigenen Fabriken vorhanden.</div>
                {{/if}}
            {{else}}
            <div class="p-3 text-warning">Die Fabrikdaten konnten aktuell nicht von der Vio-API geladen werden.</div>
            {{/if}}
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header"><i class="fas fa-database me-2"></i>Gespeicherter Überwachungsstand (GWData)</div>
        <div class="card-body p-0">
            {{#if trackedFactories.length}}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Fabrik</th>
                            <th>Standort</th>
                            <th>Gespeicherte Einnahme</th>
                            <th>Aktuelle API-Einnahme</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each trackedFactories}}
                        <tr>
                            <td class="text-muted">{{this.ID}}</td>
                            <td>{{this.type}}</td>
                            <td>{{this.name}}</td>
                            <td>
                                {{#if this.NextCapture}}
                                {{formatTime (multi this.NextCapture 1000)}}
                                {{else}}
                                <span class="text-muted">Keine Angabe</span>
                                {{/if}}
                            </td>
                            <td>
                                {{#unless this.comparisonAvailable}}
                                <span class="text-muted">API-Daten nicht verfügbar</span>
                                {{else}}
                                {{#if this.currentlyOwned}}
                                    {{#if this.currentNextCapture}}
                                    {{formatTime (multi this.currentNextCapture 1000)}}
                                    {{else}}
                                    <span class="text-muted">Keine Angabe</span>
                                    {{/if}}
                                {{else}}
                                <span class="text-muted">Nicht in API-Antwort</span>
                                {{/if}}
                                {{/unless}}
                            </td>
                            <td>
                                {{#unless this.comparisonAvailable}}
                                <span class="badge bg-secondary">Vergleich nicht möglich</span>
                                {{else}}
                                {{#unless this.currentlyOwned}}
                                <span class="badge bg-warning text-dark">Nicht mehr gemeldet</span>
                                {{else}}
                                    {{#if this.captureChanged}}
                                    <span class="badge bg-danger">Abweichung – Angriff erkannt</span>
                                    {{else}}
                                    <span class="badge bg-success">Wird überwacht</span>
                                    {{/if}}
                                {{/unless}}
                                {{/unless}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
                {{#if trackingDataAvailable}}
                <div class="p-3 text-muted">Für Fabriken ist noch kein Überwachungsstand in GWData gespeichert.</div>
                {{/if}}
            {{/if}}
        </div>
    </div>
</div>

{{/inline}} {{/layouts/base}}
